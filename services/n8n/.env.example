# Copy this file to .env and fill in the values. .env is gitignored.

# Generate with: openssl rand -hex 32
# IMPORTANT: this key encrypts your credentials in n8n. Lose it = lose them.
# REQUIRED: docker compose up will fail fast if this is empty.
N8N_ENCRYPTION_KEY=

# --- Image pinning (override to bump deliberately) ---
# N8N_IMAGE_TAG=2.47.2
# CLOUDFLARED_IMAGE_TAG=2026.10.7

# Optional: timezone (default Europe/Paris).
TZ=Europe/Paris

# --- Public access: Cloudflare named tunnel (#143, ADR 0012) ---
# N8N_WEBHOOK_URL replaces WEBHOOK_URL (no longer read by the compose).
# REQUIRED. Stable public hostname, set as the tunnel's public hostname route in
# the Cloudflare dashboard (Networking > Tunnels). N8N_WEBHOOK_URL keeps its trailing slash.
N8N_HOST=n8n.example.com
N8N_WEBHOOK_URL=https://n8n.example.com/
# Tunnel token (Cloudflare dashboard > Networking > Tunnels > the tunnel >
# Add a replica > install command, token only). REQUIRED: docker compose up fails fast if it is empty.
# Rotation procedure: services/n8n/README.md.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Used inside n8n workflows (set via n8n UI as credentials) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=
