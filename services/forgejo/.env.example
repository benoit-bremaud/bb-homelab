# services/forgejo — copy to .env (chmod 600) and fill in. Never commit .env.

# REQUIRED. Global secret key (encrypts 2FA secrets and stored tokens).
# Generated once on the Pi and written straight into .env, never typed or
# displayed (README, Bootstrap step 3). Changing it later makes those
# secrets unreadable. Keep a copy in the password manager.
FORGEJO_SECRET_KEY=

# Image tag. LTS line (ADR 0011). Back up before any bump.
# FORGEJO_IMAGE_TAG=15.0.12-rootless

# uid:gid of the container and of /mnt/appdata/forgejo.
# FORGEJO_UID=1000
# FORGEJO_GID=1000

# Log level: Trace, Debug, Info, Warn, Error.
# FORGEJO_LOG_LEVEL=Info

# TZ=Europe/Paris
