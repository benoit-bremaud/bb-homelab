# Copy to .env on the Pi (gitignored), then fill DB_PASSWORD.
# Reference: https://docs.immich.app/install/environment-variables

TZ=Europe/Paris

# Random, letters and digits only (A-Za-z0-9), no spaces. Store it in the
# password manager next to the Pi entry.
DB_PASSWORD=change-me

# Must match POSTGRES_USER / POSTGRES_DB in docker-compose.yml.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
