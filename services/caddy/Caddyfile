# bb-homelab reverse proxy — phase 1 (tailnet-only, TLS via internal CA).
#
# Every route below uses Caddy's internal CA (`tls internal`) because no
# public domain is owned yet (decision #28). When a domain arrives, swap
# `tls internal` for the default ACME flow (just remove the directive
# and rename the hosts to the public FQDN).
#
# Root CA to install on every client device (laptop, phone, family
# laptops). Copy it from the container after the first start:
#   docker exec bb-homelab-caddy cat /data/caddy/pki/authorities/local/root.crt
# See services/caddy/README.md for the full install procedure.
# (no global options block — admin API listens on its default
# localhost:2019 inside the container only; not exposed to the host
# or to any backend network. Required by `caddy reload` to
# apply Caddyfile changes without restarting the container.)

# ---- Tailnet-only guard (ADR 0009, #200) ----
# Every site refuses clients outside the Tailscale ranges with a 403. A
# compromised backend shares a network with Caddy and arrives from a
# Docker IP, so it gains nothing by going through Caddy beyond the health
# paths and Kuma's token-gated push (#217). The arguments
# are the paths left open: the service's exact health path, so Uptime
# Kuma (also on a Docker IP) can probe it, and, on Kuma only, the push
# endpoints the Pi's own scripts call through 127.0.0.1 (#161), which
# Caddy sees from the Docker gateway IP.
(tailnet_only) {
	@outside_tailnet {
		not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
		not path {args[:]}
	}
	respond @outside_tailnet 403
}

# ---- n8n ----
# n8n.bb-homelab.local → n8n container on its own proxy network.
# Client devices add a single /etc/hosts entry pointing *.bb-homelab.local
# to the Pi's Tailscale IP; routing is handled here.
n8n.bb-homelab.local {
	tls internal
	import tailnet_only /healthz
	reverse_proxy n8n:5678
}

# ---- jellyfin ----
# jellyfin.bb-homelab.local → Jellyfin media server on its own proxy
# network. Browsers that trust the internal CA use this hostname; TV /
# mobile apps that cannot install the CA use the direct port instead
# (http://bb-homelab:8096, published by services/jellyfin/).
jellyfin.bb-homelab.local {
	tls internal
	import tailnet_only /health
	reverse_proxy jellyfin:8096
}

# ---- Uptime Kuma ----
# status.bb-homelab.local → uptime-kuma container (Stack B monitoring,
# issue #44). Reached over its own proxy network.
status.bb-homelab.local {
	tls internal
	import tailnet_only /api/entry-page /api/push/*
	reverse_proxy uptime-kuma:3001
}

# ---- Vaultwarden ----
# vaultwarden.bb-homelab.local → vaultwarden container (password manager,
# issue #25). Reached over its own proxy network. A single
# reverse_proxy is sufficient: since Vaultwarden 1.31 the WebSocket
# (/notifications/hub) is served by Rocket on the same port 8080, and Caddy
# upgrades WebSocket connections automatically — no separate hub block.
# X-Real-IP is forwarded so Vaultwarden logs the true tailnet client IP
# (for its admin-panel rate-limiting / fail2ban) instead of Caddy's
# container IP.
# Tailnet-only: Caddy publishes 80/443 on every host interface (LAN and
# global IPv6), and Docker-published ports bypass ufw. Any client whose
# source IP is outside the Tailscale ranges gets a 403 before reaching
# the vault (bb-vault#20), except on the exact /alive health path.
vaultwarden.bb-homelab.local {
	tls internal
	# HSTS: browsers refuse plain HTTP for a year after the first visit
	# (bb-vault#24). No preload: .local cannot be on the preload list.
	header Strict-Transport-Security "max-age=31536000"
	import tailnet_only /alive
	# The /admin panel can disable 2FA and delete users: only the admin
	# PC (vev-xps-15-9530) may reach it; everyone else sees a 404
	# (bb-vault#21). Update the IP if that device is re-enrolled.
	@admin_not_pc {
		path /admin /admin/*
		not remote_ip 100.67.85.126
	}
	respond @admin_not_pc 404
	reverse_proxy vaultwarden:8080 {
		header_up X-Real-IP {remote_host}
	}
}

# ---- Homepage (landing dashboard) ----
# home.bb-homelab.local → homepage container (link launcher + status,
# issue #125). Reached over its own proxy network. The
# upstream is the compose SERVICE name `homepage` (like uptime-kuma:3001),
# not the hostname `home`.
home.bb-homelab.local {
	tls internal
	import tailnet_only /api/healthcheck
	reverse_proxy homepage:3000
}

# ---- PopCornTV ----
# popcorntv.bb-homelab.local → PopCornTV media app (#240), replacing
# Jellyfin. The web build is served from the popcorntv-web volume; the API
# sits at 10.203.60.3 on its own proxy network. Reference copy:
# popcorntv repo, deploy/homelab/Caddyfile — keep both in step.
# Reference snippet and site block for the bb-homelab Caddy (ADR-0013, issue #46). The Caddy container
# joins `bb-homelab-proxy-popcorntv` at 10.203.60.2 and mounts the `popcorntv-web` volume
# read-only at /srv/popcorntv-web. The `tailnet_only` snippet is defined at the top of the
# bb-homelab Caddyfile. Keep deploy/staging/Caddyfile (local staging, #204) in step.

# Security headers, imported by the site and by its error routes: `handle_errors` does not
# run the site's `header` directives (#177).
(popcorntv_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		# No inline script or style (#31). hls.js plays through MediaSource blob: URLs and runs
		# its demuxer in a blob: worker.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

popcorntv.bb-homelab.local {
	tls internal
	import tailnet_only /api/health

	encode zstd gzip

	import popcorntv_headers

	# The API answers without the /api prefix, like the Vite dev proxy.
	handle_path /api/* {
		reverse_proxy 10.203.60.3:3000
	}

	# Hashed build assets: cached for good, and a missing one is a 404, never index.html.
	# `/api/..%2fassets/x.js` cleans to /assets/x.js: the raw /api path keeps it an API miss.
	@assets {
		path /assets/*
		not expression `{http.request.orig_uri.path}.startsWith("/api/")`
	}
	handle @assets {
		root * /srv/popcorntv-web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Caddy matches on the decoded, cleaned path: `/api/x/..%2f..%2fetc` reaches the
	# routes below as `/etc`. The raw path still says /api, so it is an API miss (#177).
	@rawApi expression `{http.request.orig_uri.path}.startsWith("/api/") || {http.request.orig_uri.path} == "/api"`
	handle @rawApi {
		header Content-Type application/json
		respond `{"error":"not_found"}` 404
	}

	# The app has no client routes: only real files and `/` (index.html) exist. Anything
	# else is a real 404 with the static 404 page (#177), never index.html with a 200.
	handle {
		root * /srv/popcorntv-web
		header Cache-Control "no-cache"
		# A path under a file (`/index.html/x`) would be a bare 400 from file_server.
		@missing not file {path} {path}index.html
		error @missing 404
		file_server
	}

	handle_errors 404 {
		import popcorntv_headers
		root * /srv/popcorntv-web
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}

# ---- Health check ----
# Plain-HTTP liveness endpoint for the Docker healthcheck (see
# docker-compose.yml). Scoped to the `localhost` host on HTTP only, so it
# never collides with the *.bb-homelab.local sites above and needs no TLS —
# the in-container probe cannot verify the internal CA. Returns 200.
http://localhost {
	handle /healthz {
		respond 200
	}
}
